{
  "manifest_version": 3,
  "name": "Prompt Expander (>_)",
  "version": "1.0.0",
  "description": "Expand custom triggers like >_use-analyzer-prompt into reusable prompts across chat interfaces and other browser text fields.",
  "permissions": ["storage", "clipboardRead"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "options_page": "src/options/index.html",
  "commands": {
    "open-options": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Option+Shift+P"
      },
      "description": "Open snippet settings"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.js"],
      "run_at": "document_idle"
    }
  ]
}
